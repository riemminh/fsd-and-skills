{
  "mcpServers": {
    "agentmemory": {
      "command": "/bin/zsh",
      "args": [
        "-il",
        "-c",
        "exec npx -y @agentmemory/agentmemory mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_PROBE_TIMEOUT_MS": "15000"
      }
    },
    "context7": {
      "command": "/bin/zsh",
      "args": [
        "-il",
        "-c",
        "exec npx -y @upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "ctx7sk-a07054db-2523-476c-891a-a683c800ae20"
      }
    }
  }
}
